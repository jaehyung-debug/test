generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  ACCOUNTING
}

enum ClientType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum TaxType {
  TAXABLE
  ZERO_RATED
  TAX_EXEMPT
}

enum QuotationStatus {
  DRAFT
  REVIEW_REQUESTED
  APPROVED
  REJECTED
  SENT
  NEGOTIATING
  CONTRACTED
  ON_HOLD
  CANCELED
  EXPIRED
}

enum QuotationCostCategory {
  MATERIAL
  LABOR
  EXPENSE
  TRAVEL
}

enum ProjectStatus {
  PLANNED
  QUOTING
  CONTRACTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  SETTLING
  CLOSED
  CANCELED
}

enum ExpenseStatus {
  DRAFT
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CORPORATE_CARD
  OTHER
}

enum EvidenceType {
  TAX_INVOICE
  CARD_RECEIPT
  CASH_RECEIPT
  SIMPLE_RECEIPT
  NONE
}

enum ExpenseAmountInputType {
  SUPPLY
  TOTAL
}

enum StatementType {
  TRANSACTION
  DELIVERY
  WORK
  COST
  MATERIAL
  BILLING
}

enum StatementStatus {
  DRAFT
  ISSUED
  CANCELED
}

enum PaymentType {
  ADVANCE
  INTERIM
  BALANCE
  FULL
  OTHER
}

enum ReceivableDueType {
  DATE
  NEGOTIATION
}

enum IncomingPaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OFFSET
  OTHER
}

enum OrderStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum OrderStageStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}

enum CalendarType {
  PERSONAL
  SHARED
  PROJECT
  ORDER
}

enum CalendarMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum ScheduleCategory {
  MEETING
  LEAVE
  BUSINESS_TRIP
  WEEKEND_WORK
  EXTERNAL_MEETING
  INTERNAL_TRAINING
  TASK
  DELIVERY
  OTHER
}

enum ScheduleRepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ApprovalTargetType {
  QUOTATION
  EXPENSE
  PROJECT_BUDGET
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum DeliveryDeadlineType {
  DATE
  NEGOTIATION
}

enum PurchaseRfqStatus {
  DRAFT
  SENT
  PARTIALLY_RESPONDED
  RESPONDED
  VENDOR_SELECTED
  CLOSED
  CANCELED
}

enum SupplierQuotationStatus {
  REQUESTED
  RECEIVED
  SELECTED
  PARTIALLY_SELECTED
  REJECTED
  EXPIRED
  CANCELED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVAL_REQUESTED
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  INSPECTED
  CLOSED
  ON_HOLD
  CANCELED
}

enum PurchaseDeliveryDeadlineType {
  DATE
  NEGOTIATION
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  INSPECTED
  PARTIALLY_REJECTED
  REJECTED
  CANCELED
}

enum PurchaseDisbursementType {
  ADVANCE
  INTERIM
  BALANCE
  FULL
  OTHER
}

enum PurchaseDisbursementTrigger {
  AFTER_ORDER
  AFTER_PARTIAL_RECEIPT
  AFTER_FULL_RECEIPT
  AFTER_INSPECTION
  SPECIFIC_DATE
  MANUAL
}

enum PurchaseDisbursementStatus {
  PLANNED
  REQUESTED
  APPROVED
  SCHEDULED
  EXECUTED
  ON_HOLD
  REJECTED
  CANCELED
}

enum BusinessDocumentType {
  QUOTATION
  ORDER
  PURCHASE_RFQ
  SUPPLIER_QUOTATION
  PURCHASE_ORDER
  GOODS_RECEIPT
  PURCHASE_DISBURSEMENT
  EXPENSE
  TRANSACTION_STATEMENT
}

enum DocumentRelationType {
  GENERATED_FROM
  RELATED_TO
  SETTLEMENT_FOR
  COST_FOR
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String
  name                   String
  phone                  String?
  role                   Role                   @default(STAFF)
  department             String?
  position               String?
  isActive               Boolean                @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  clients                Client[]
  createdQuotations      Quotation[]            @relation("QuotationCreator")
  approvedQuotations     Quotation[]            @relation("QuotationApprover")
  managedProjects        Project[]
  requestedExpenses      Expense[]              @relation("ExpenseRequester")
  approvedExpenses       Expense[]              @relation("ExpenseApprover")
  statements             Statement[]
  payments               Payment[]
  requestedApprovals     Approval[]             @relation("ApprovalRequester")
  assignedApprovals      Approval[]             @relation("ApprovalApprover")
  attachments            Attachment[]
  auditLogs              AuditLog[]
  managedOrders          Order[]                @relation("OrderManager")
  assignedOrderStages    OrderStage[]           @relation("OrderStageAssignee")
  completedOrderStages   OrderStage[]           @relation("OrderStageCompleter")
  ownedCalendars         Calendar[]             @relation("CalendarOwner")
  calendarMemberships    CalendarMember[]
  createdSchedules       ScheduleEvent[]        @relation("ScheduleCreator")
  scheduleAttendances    ScheduleAttendee[]
  purchaseRfqs           PurchaseRfq[]          @relation("PurchaseRfqRequester")
  supplierQuotes         SupplierQuotation[]    @relation("SupplierQuotationReceiver")
  purchaseOrders         PurchaseOrder[]        @relation("PurchaseOrderCreator")
  goodsReceipts          GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  requestedDisbursements PurchaseDisbursement[] @relation("DisbursementRequester")
  approvedDisbursements  PurchaseDisbursement[] @relation("DisbursementApprover")
  executedDisbursements  PurchaseDisbursement[] @relation("DisbursementExecutor")
  overrideDisbursements  PurchaseDisbursement[] @relation("DisbursementOverrideApprover")

  @@index([deletedAt])
}

model CompanySetting {
  id                 String   @id @default(cuid())
  companyName        String
  businessNumber     String   @unique
  representativeName String
  businessType       String?
  businessCategory   String?
  phone              String?
  email              String?
  address            String?
  logoUrl            String?
  sealUrl            String?
  sealOriginalName   String?
  bankName           String?
  bankAccount        String?
  accountHolder      String?
  defaultVatRate     Decimal  @default(10)
  defaultToolLossRate Decimal @default(0)
  defaultGeneralAdminRate Decimal @default(0)
  defaultSafetyHealthRate Decimal @default(0)
  quotationPrefix    String   @default("Q")
  statementPrefix    String   @default("S")
  projectPrefix      String   @default("P")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupplierProfile {
  id                   String   @id @default(cuid())
  profileName          String
  companyName          String
  businessNumber       String
  representativeName   String
  businessType         String?
  businessCategory     String?
  address              String?
  detailedAddress      String?
  postalCode           String?
  phone                String?
  fax                   String?
  email                String?
  documentManagerName  String?
  documentManagerPhone String?
  documentManagerEmail String?
  bankName             String?
  bankAccount          String?
  accountHolder        String?
  logoUrl              String?
  logoOriginalName     String?
  sealUrl              String?
  sealOriginalName     String?
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  quotations           Quotation[]
  statements           Statement[]

  @@index([isDefault, isActive, deletedAt])
  @@index([businessNumber])
}

model Client {
  id                           String                 @id @default(cuid())
  clientCode                   String                 @unique
  companyName                  String
  businessNumber               String                 @unique
  representativeName           String?
  contactName                  String?
  contactPhone                 String?
  contactEmail                 String?
  businessType                 String?
  businessCategory             String?
  address                      String?
  paymentTerms                 String?
  clientType                   ClientType             @default(CUSTOMER)
  memo                         String?
  createdById                  String
  createdBy                    User                   @relation(fields: [createdById], references: [id])
  quotations                   Quotation[]
  projects                     Project[]
  expenses                     Expense[]
  statements                   Statement[]
  payments                     Payment[]
  orders                       Order[]
  rfqVendors                   PurchaseRfqVendor[]
  supplierQuotations           SupplierQuotation[]
  suppliedPurchaseOrders       PurchaseOrder[]
  suppliedDisbursements        PurchaseDisbursement[]
  purchaseContactName          String?
  purchaseContactPhone         String?
  purchaseContactEmail         String?
  purchaseBankName             String?
  purchaseAccountNumber        String?
  purchaseAccountHolder        String?
  defaultPurchasePaymentTerms  String?
  defaultPurchaseDeliveryTerms String?
  supplierMemo                 String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  deletedAt                    DateTime?

  @@index([companyName])
  @@index([deletedAt])
}

model Product {
  id             String          @id @default(cuid())
  productCode    String          @unique
  name           String
  specification  String?
  unit           String
  defaultPrice   Decimal
  taxType        TaxType         @default(TAXABLE)
  category       String?
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  quotationItems QuotationItem[]
}

model Quotation {
  id                   String               @id @default(cuid())
  quotationNumber      String
  revision             Int                  @default(1)
  clientId             String
  client               Client               @relation(fields: [clientId], references: [id])
  projectName          String
  title                String
  quotationDate        DateTime
  validUntil           DateTime?
  expectedStartDate    DateTime?
  expectedEndDate      DateTime?
  paymentTerms         String?
  deliveryTerms        String?
  deliveryDeadlineType DeliveryDeadlineType @default(NEGOTIATION)
  deliveryDeadlineDate DateTime?
  note                 String?
  status               QuotationStatus      @default(DRAFT)
  subtotal             Decimal
  discountAmount       Decimal
  taxableAmount        Decimal
  vatAmount            Decimal
  totalAmount          Decimal
  materialAmount       Decimal              @default(0)
  laborAmount          Decimal              @default(0)
  expenseAmount        Decimal              @default(0)
  travelAmount         Decimal              @default(0)
  directCostAmount     Decimal              @default(0)
  toolLossRate         Decimal              @default(0)
  toolLossAmount       Decimal              @default(0)
  generalAdminRate     Decimal              @default(0)
  generalAdminAmount   Decimal              @default(0)
  safetyHealthRate     Decimal              @default(0)
  safetyHealthAmount   Decimal              @default(0)
  supplierProfileId    String?
  supplierProfile      SupplierProfile?     @relation(fields: [supplierProfileId], references: [id])
  supplierSnapshot     Json?
  showSupplierLogo     Boolean              @default(true)
  showSupplierSeal     Boolean              @default(true)
  createdById          String
  createdBy            User                 @relation("QuotationCreator", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?                @relation("QuotationApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  sentAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  items                QuotationItem[]
  project              Project?
  statements           Statement[]
  orders               Order[]
  purchaseRfqs         PurchaseRfq[]
  purchaseOrders       PurchaseOrder[]

  @@unique([quotationNumber, revision])
  @@index([clientId, status])
  @@index([deletedAt])
}

model QuotationItem {
  id               String            @id @default(cuid())
  quotationId      String
  quotation        Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?          @relation(fields: [productId], references: [id])
  sortOrder        Int
  name             String
  specification    String?
  unit             String
  quantity         Decimal
  unitPrice        Decimal
  discountRate     Decimal
  supplyAmount     Decimal
  vatAmount        Decimal
  totalAmount      Decimal
  taxType          TaxType
  costCategory     QuotationCostCategory @default(MATERIAL)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRfqItems PurchaseRfqItem[]

  @@index([quotationId, sortOrder])
}

model Project {
  id                    String                 @id @default(cuid())
  projectCode           String                 @unique
  projectName           String
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  quotationId           String?                @unique
  quotation             Quotation?             @relation(fields: [quotationId], references: [id])
  managerId             String
  manager               User                   @relation(fields: [managerId], references: [id])
  description           String?
  memo                  String?
  startDate             DateTime
  expectedEndDate       DateTime?
  actualEndDate         DateTime?
  contractAmount        Decimal
  budgetAmount          Decimal
  progressRate          Decimal                @default(0)
  status                ProjectStatus          @default(PLANNED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  budgets               ProjectBudget[]
  expenses              Expense[]
  statements            Statement[]
  payments              Payment[]
  receivableSchedules   ReceivableSchedule[]
  orders                Order[]
  calendars             Calendar[]
  scheduleEvents        ScheduleEvent[]
  purchaseRfqs          PurchaseRfq[]
  purchaseOrders        PurchaseOrder[]
  purchaseDisbursements PurchaseDisbursement[]

  @@index([clientId, status])
  @@index([deletedAt])
}

model ExpenseCategory {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  isActive              Boolean                @default(true)
  sortOrder             Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  budgets               ProjectBudget[]
  expenses              Expense[]
  purchaseDisbursements PurchaseDisbursement[]
}

model ProjectBudget {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  budgetAmount      Decimal
  memo              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([projectId, expenseCategoryId])
}

model Expense {
  id                   String                 @id @default(cuid())
  expenseNumber        String                 @unique
  projectId            String
  project              Project                @relation(fields: [projectId], references: [id])
  expenseCategoryId    String
  expenseCategory      ExpenseCategory        @relation(fields: [expenseCategoryId], references: [id])
  supplierId           String?
  supplier             Client?                @relation(fields: [supplierId], references: [id])
  supplierName         String?
  expenseDate          DateTime
  description          String
  quantity             Decimal
  unitPrice            Decimal
  supplyAmount         Decimal
  vatAmount            Decimal
  totalAmount          Decimal
  vatRate              Decimal                @default(10)
  amountInputType      ExpenseAmountInputType @default(SUPPLY)
  paymentMethod        PaymentMethod
  payerName            String?
  evidenceType         EvidenceType
  evidenceFileUrl      String?
  status               ExpenseStatus          @default(DRAFT)
  requestedById        String
  requestedBy          User                   @relation("ExpenseRequester", fields: [requestedById], references: [id])
  approvedById         String?
  approvedBy           User?                  @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  paidAt               DateTime?
  memo                 String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  purchaseDisbursement PurchaseDisbursement?

  @@index([projectId, status])
  @@index([deletedAt])
}

model Statement {
  id                   String          @id @default(cuid())
  statementNumber      String          @unique
  statementType        StatementType
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id])
  projectId            String?
  project              Project?        @relation(fields: [projectId], references: [id])
  quotationId          String?
  quotation            Quotation?      @relation(fields: [quotationId], references: [id])
  statementDate        DateTime
  deliveryDate         DateTime?
  title                String
  subtotal             Decimal
  vatAmount            Decimal
  totalAmount          Decimal
  note                 String?
  recipientManagerName String?
  recipientDepartment  String?
  recipientPhone       String?
  recipientEmail       String?
  supplierMemo         String?
  printRemark          String?
  supplierProfileId    String?
  supplierProfile      SupplierProfile? @relation(fields: [supplierProfileId], references: [id])
  supplierSnapshot     Json?
  showSupplierLogo     Boolean         @default(true)
  showSupplierSeal     Boolean         @default(true)
  status               StatementStatus @default(DRAFT)
  createdById          String
  createdBy            User            @relation(fields: [createdById], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  items                StatementItem[]

  @@index([clientId, status])
  @@index([deletedAt])
}

model StatementItem {
  id            String    @id @default(cuid())
  statementId   String
  statement     Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  sortOrder     Int
  name          String
  specification String?
  unit          String
  quantity      Decimal
  unitPrice     Decimal
  supplyAmount  Decimal
  vatAmount     Decimal
  totalAmount   Decimal
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([statementId, sortOrder])
}

model Payment {
  id                    String                @id @default(cuid())
  paymentNumber         String                @unique
  clientId              String
  client                Client                @relation(fields: [clientId], references: [id])
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id])
  paymentDate           DateTime
  amount                Decimal
  paymentType           PaymentType
  receivableScheduleId  String?
  receivableSchedule    ReceivableSchedule?   @relation(fields: [receivableScheduleId], references: [id])
  incomingPaymentMethod IncomingPaymentMethod @default(BANK_TRANSFER)
  depositorName         String?
  bankName              String?
  accountNumber         String?
  taxInvoiceIssued      Boolean               @default(false)
  taxInvoiceDate        DateTime?
  confirmedById         String
  confirmedBy           User                  @relation(fields: [confirmedById], references: [id])
  memo                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  @@index([projectId, paymentDate])
  @@index([deletedAt])
}

model ReceivableSchedule {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  sequence         Int
  paymentType      PaymentType
  title            String
  expectedAmount   Decimal
  dueType          ReceivableDueType @default(NEGOTIATION)
  dueDate          DateTime?
  taxInvoiceIssued Boolean           @default(false)
  taxInvoiceDate   DateTime?
  taxInvoiceNumber String?
  memo             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  payments         Payment[]

  @@unique([projectId, sequence])
  @@index([projectId, dueDate])
  @@index([deletedAt])
}

model Approval {
  id              String             @id @default(cuid())
  targetType      ApprovalTargetType
  targetId        String
  requesterId     String
  requester       User               @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approverId      String
  approver        User               @relation("ApprovalApprover", fields: [approverId], references: [id])
  step            Int
  status          ApprovalStatus     @default(PENDING)
  requestComment  String?
  approvalComment String?
  requestedAt     DateTime           @default(now())
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([targetType, targetId, step])
  @@index([approverId, status])
}

model Attachment {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  originalName String
  storedName   String    @unique
  fileUrl      String
  mimeType     String
  fileSize     BigInt
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String
  targetId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model DocumentSequence {
  id           String   @id @default(cuid())
  type         String
  year         Int
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([type, year])
}

model OrderWorkflowTemplate {
  id          String                       @id @default(cuid())
  name        String                       @unique
  description String?
  isActive    Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  stages      OrderWorkflowStageTemplate[]
  orders      Order[]
}

model OrderWorkflowStageTemplate {
  id                  String                @id @default(cuid())
  templateId          String
  template            OrderWorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageCode           String
  stageName           String
  sortOrder           Int
  color               String?
  defaultDurationDays Int                   @default(0)
  isRequired          Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([templateId, stageCode])
  @@unique([templateId, sortOrder])
}

model Order {
  id                 String                @id @default(cuid())
  orderNumber        String                @unique
  orderName          String
  workflowTemplateId String
  workflowTemplate   OrderWorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  clientId           String
  client             Client                @relation(fields: [clientId], references: [id])
  quotationId        String?
  quotation          Quotation?            @relation(fields: [quotationId], references: [id])
  projectId          String?
  project            Project?              @relation(fields: [projectId], references: [id])
  managerId          String
  manager            User                  @relation("OrderManager", fields: [managerId], references: [id])
  baseDate           DateTime
  dueDate            DateTime?
  status             OrderStatus           @default(DRAFT)
  progressRate       Decimal               @default(0)
  note               String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  stages             OrderStage[]
  calendars          Calendar[]
  scheduleEvents     ScheduleEvent[]
  purchaseRfqs       PurchaseRfq[]
  purchaseOrders     PurchaseOrder[]

  @@index([clientId, status])
  @@index([projectId])
  @@index([deletedAt])
}

model OrderStage {
  id             String               @id @default(cuid())
  orderId        String
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageCode      String
  stageName      String
  sortOrder      Int
  color          String?
  isRequired     Boolean              @default(true)
  status         OrderStageStatus     @default(PENDING)
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualStartAt  DateTime?
  actualEndAt    DateTime?
  assigneeId     String?
  assignee       User?                @relation("OrderStageAssignee", fields: [assigneeId], references: [id])
  memo           String?
  completedById  String?
  completedBy    User?                @relation("OrderStageCompleter", fields: [completedById], references: [id])
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  links          OrderStageLink[]
  schedules      OrderStageSchedule[]
  scheduleEvents ScheduleEvent[]

  @@unique([orderId, sortOrder])
  @@index([orderId, status])
  @@index([assigneeId])
}

model OrderStageLink {
  id           String     @id @default(cuid())
  orderStageId String
  orderStage   OrderStage @relation(fields: [orderStageId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  label        String?
  createdAt    DateTime   @default(now())

  @@index([targetType, targetId])
}

model OrderStageSchedule {
  id           String     @id @default(cuid())
  orderStageId String
  orderStage   OrderStage @relation(fields: [orderStageId], references: [id], onDelete: Cascade)
  title        String
  startAt      DateTime
  endAt        DateTime?
  createdAt    DateTime   @default(now())

  @@index([orderStageId, startAt])
}

model PurchaseRfq {
  id                   String              @id @default(cuid())
  rfqNumber            String              @unique
  title                String
  sourceQuotationId    String?
  sourceQuotation      Quotation?          @relation(fields: [sourceQuotationId], references: [id])
  sourceOrderId        String?
  sourceOrder          Order?              @relation(fields: [sourceOrderId], references: [id])
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id])
  requestDate          DateTime
  responseDueDate      DateTime?
  requiredDeliveryDate DateTime?
  deliveryPlace        String?
  requesterId          String
  requester            User                @relation("PurchaseRfqRequester", fields: [requesterId], references: [id])
  status               PurchaseRfqStatus   @default(DRAFT)
  note                 String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  items                PurchaseRfqItem[]
  vendors              PurchaseRfqVendor[]
  supplierQuotations   SupplierQuotation[]
  purchaseOrders       PurchaseOrder[]

  @@index([status, responseDueDate])
  @@index([sourceOrderId])
  @@index([deletedAt])
}

model PurchaseRfqItem {
  id                     String                  @id @default(cuid())
  rfqId                  String
  rfq                    PurchaseRfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sourceQuotationItemId  String?
  sourceQuotationItem    QuotationItem?          @relation(fields: [sourceQuotationItemId], references: [id])
  sortOrder              Int
  itemCode               String?
  name                   String
  specification          String?
  unit                   String
  requestedQuantity      Decimal
  targetUnitPrice        Decimal?
  preferredMaker         String?
  requiredDeliveryDate   DateTime?
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  supplierQuotationItems SupplierQuotationItem[]
  purchaseOrderItems     PurchaseOrderItem[]

  @@unique([rfqId, sortOrder])
}

model PurchaseRfqVendor {
  id             String      @id @default(cuid())
  rfqId          String
  rfq            PurchaseRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Client      @relation(fields: [supplierId], references: [id])
  recipientName  String?
  recipientEmail String?
  sentAt         DateTime?
  respondedAt    DateTime?
  note           String?

  @@unique([rfqId, supplierId])
}

model SupplierQuotation {
  id                      String                  @id @default(cuid())
  supplierQuotationNumber String                  @unique
  rfqId                   String
  rfq                     PurchaseRfq             @relation(fields: [rfqId], references: [id])
  supplierId              String
  supplier                Client                  @relation(fields: [supplierId], references: [id])
  supplierDocumentNumber  String?
  quotationDate           DateTime
  validUntil              DateTime?
  deliveryLeadDays        Int?
  deliveryTerms           String?
  paymentTerms            String?
  subtotal                Decimal
  vatAmount               Decimal
  totalAmount             Decimal
  status                  SupplierQuotationStatus @default(RECEIVED)
  receivedById            String
  receivedBy              User                    @relation("SupplierQuotationReceiver", fields: [receivedById], references: [id])
  note                    String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  items                   SupplierQuotationItem[]
  purchaseOrders          PurchaseOrder[]

  @@index([rfqId, supplierId])
  @@index([deletedAt])
}

model SupplierQuotationItem {
  id                  String              @id @default(cuid())
  supplierQuotationId String
  supplierQuotation   SupplierQuotation   @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  rfqItemId           String
  rfqItem             PurchaseRfqItem     @relation(fields: [rfqItemId], references: [id])
  sortOrder           Int
  quotedQuantity      Decimal
  unitPrice           Decimal
  supplyAmount        Decimal
  vatAmount           Decimal
  totalAmount         Decimal
  deliveryDate        DateTime?
  maker               String?
  modelName           String?
  note                String?
  isSelected          Boolean             @default(false)
  selectionReason     String?
  purchaseOrderItems  PurchaseOrderItem[]

  @@unique([supplierQuotationId, rfqItemId])
}

model PurchaseOrder {
  id                   String                       @id @default(cuid())
  purchaseOrderNumber  String                       @unique
  rfqId                String?
  rfq                  PurchaseRfq?                 @relation(fields: [rfqId], references: [id])
  supplierQuotationId  String?
  supplierQuotation    SupplierQuotation?           @relation(fields: [supplierQuotationId], references: [id])
  sourceQuotationId    String?
  sourceQuotation      Quotation?                   @relation(fields: [sourceQuotationId], references: [id])
  sourceOrderId        String?
  sourceOrder          Order?                       @relation(fields: [sourceOrderId], references: [id])
  projectId            String?
  project              Project?                     @relation(fields: [projectId], references: [id])
  supplierId           String
  supplier             Client                       @relation(fields: [supplierId], references: [id])
  orderDate            DateTime
  deliveryDeadlineType PurchaseDeliveryDeadlineType @default(DATE)
  deliveryDeadlineDate DateTime?
  deliveryPlace        String?
  paymentTerms         String?
  subtotal             Decimal
  discountAmount       Decimal                      @default(0)
  vatAmount            Decimal
  totalAmount          Decimal
  status               PurchaseOrderStatus          @default(DRAFT)
  orderedById          String
  orderedBy            User                         @relation("PurchaseOrderCreator", fields: [orderedById], references: [id])
  approvedById         String?
  approvedAt           DateTime?
  sentAt               DateTime?
  note                 String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?
  items                PurchaseOrderItem[]
  receipts             GoodsReceipt[]
  disbursements        PurchaseDisbursement[]

  @@index([supplierId, status])
  @@index([deliveryDeadlineDate])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id                      String                 @id @default(cuid())
  purchaseOrderId         String
  purchaseOrder           PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rfqItemId               String?
  rfqItem                 PurchaseRfqItem?       @relation(fields: [rfqItemId], references: [id])
  supplierQuotationItemId String?
  supplierQuotationItem   SupplierQuotationItem? @relation(fields: [supplierQuotationItemId], references: [id])
  sortOrder               Int
  itemCode                String?
  name                    String
  specification           String?
  unit                    String
  orderedQuantity         Decimal
  unitPrice               Decimal
  supplyAmount            Decimal
  vatAmount               Decimal
  totalAmount             Decimal
  requestedDeliveryDate   DateTime?
  note                    String?
  receiptItems            GoodsReceiptItem[]

  @@unique([purchaseOrderId, sortOrder])
}

model GoodsReceipt {
  id                 String             @id @default(cuid())
  goodsReceiptNumber String             @unique
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receiptDate        DateTime
  deliveryLocation   String?
  receivedById       String
  receivedBy         User               @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])
  status             GoodsReceiptStatus @default(RECEIVED)
  supplierDocumentNo String?
  overReceiptReason  String?
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  items              GoodsReceiptItem[]

  @@index([purchaseOrderId, receiptDate])
  @@index([deletedAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  receivedQuantity    Decimal
  acceptedQuantity    Decimal
  rejectedQuantity    Decimal
  defectReason        String?
  note                String?

  @@unique([goodsReceiptId, purchaseOrderItemId])
}

model PurchaseDisbursement {
  id                       String                      @id @default(cuid())
  disbursementNumber       String                      @unique
  purchaseOrderId          String
  purchaseOrder            PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id])
  projectId                String?
  project                  Project?                    @relation(fields: [projectId], references: [id])
  supplierId               String
  supplier                 Client                      @relation(fields: [supplierId], references: [id])
  paymentType              PurchaseDisbursementType
  triggerType              PurchaseDisbursementTrigger
  plannedDate              DateTime?
  requestedDate            DateTime?
  approvedDate             DateTime?
  executedDate             DateTime?
  supplyAmount             Decimal
  vatAmount                Decimal
  totalAmount              Decimal
  status                   PurchaseDisbursementStatus  @default(PLANNED)
  requestedById            String?
  requestedBy              User?                       @relation("DisbursementRequester", fields: [requestedById], references: [id])
  approvedById             String?
  approvedBy               User?                       @relation("DisbursementApprover", fields: [approvedById], references: [id])
  executedById             String?
  executedBy               User?                       @relation("DisbursementExecutor", fields: [executedById], references: [id])
  paymentMethod            PaymentMethod?
  bankName                 String?
  accountNumber            String?
  accountHolder            String?
  taxInvoiceReceived       Boolean                     @default(false)
  taxInvoiceDate           DateTime?
  taxInvoiceApprovalNumber String?
  expenseCategoryId        String?
  expenseCategory          ExpenseCategory?            @relation(fields: [expenseCategoryId], references: [id])
  expenseId                String?                     @unique
  expense                  Expense?                    @relation(fields: [expenseId], references: [id])
  overrideReason           String?
  overrideApprovedById     String?
  overrideApprovedBy       User?                       @relation("DisbursementOverrideApprover", fields: [overrideApprovedById], references: [id])
  overrideApprovedAt       DateTime?
  memo                     String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  deletedAt                DateTime?

  @@index([purchaseOrderId, status])
  @@index([projectId])
  @@index([deletedAt])
}

model DocumentRelation {
  id           String               @id @default(cuid())
  fromType     BusinessDocumentType
  fromId       String
  toType       BusinessDocumentType
  toId         String
  relationType DocumentRelationType
  createdAt    DateTime             @default(now())

  @@unique([fromType, fromId, toType, toId, relationType])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

model Calendar {
  id        String           @id @default(cuid())
  name      String
  type      CalendarType
  color     String?
  ownerId   String?
  owner     User?            @relation("CalendarOwner", fields: [ownerId], references: [id])
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id])
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   CalendarMember[]
  schedules ScheduleEvent[]

  @@index([ownerId, type])
  @@index([projectId])
  @@index([orderId])
}

model CalendarMember {
  id         String             @id @default(cuid())
  calendarId String
  calendar   Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  role       CalendarMemberRole @default(VIEWER)
  createdAt  DateTime           @default(now())

  @@unique([calendarId, userId])
}

model ScheduleEvent {
  id              String             @id @default(cuid())
  calendarId      String
  calendar        Calendar           @relation(fields: [calendarId], references: [id])
  title           String
  category        ScheduleCategory   @default(TASK)
  location        String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean            @default(false)
  repeatType      ScheduleRepeatType @default(NONE)
  repeatInterval  Int                @default(1)
  repeatUntil     DateTime?
  reminderMinutes Int?
  description     String?
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id])
  orderId         String?
  order           Order?             @relation(fields: [orderId], references: [id])
  orderStageId    String?
  orderStage      OrderStage?        @relation(fields: [orderStageId], references: [id])
  createdById     String
  createdBy       User               @relation("ScheduleCreator", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  attendees       ScheduleAttendee[]

  @@index([calendarId, startAt])
  @@index([projectId])
  @@index([orderId])
  @@index([orderStageId])
  @@index([deletedAt])
}

model ScheduleAttendee {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   ScheduleEvent @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([scheduleId, userId])
}
